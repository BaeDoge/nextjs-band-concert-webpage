SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Recommended current Supabase server key (starts with sb_secret_).
# Server-only: NEVER use NEXT_PUBLIC_ and NEVER commit the real value.
SUPABASE_SECRET_KEY=

# Legacy alternative (starts with eyJ...). Use only if you still use the old service_role key.
# SUPABASE_SERVICE_ROLE_KEY=

# Your own long random password for /host. Server-only.
ADMIN_ACCESS_KEY=
